{
  "manifest_version": 3,
  "name": "Dotbook — browser time",
  "version": "0.1.0",
  "description": "Records active time per site and sends it to your Dotbook server.",
  "browser_specific_settings": { "gecko": { "id": "browser-time@dotbook.dev" } },
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://localhost/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
