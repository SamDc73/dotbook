{
	"expo": {
		"name": "Dotbook",
		"slug": "dotbook",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"package": "dev.dotbook.app",
			"permissions": ["android.permission.USE_EXACT_ALARM", "android.permission.PACKAGE_USAGE_STATS"]
		},
		"web": {
			"bundler": "metro",
			"output": "single",
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router", "expo-sqlite", "expo-speech-recognition"],
		"scheme": "dotbook"
	}
}
