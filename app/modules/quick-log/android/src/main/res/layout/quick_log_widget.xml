<?xml version="1.0" encoding="utf-8"?>
<!-- The widget: the mark and "Log a line" on a rounded bar, all of it one tap
     target. Sizes are the app's own steps in dp — md padding, sm between, the
     icon size, body text. `@android:id/background` lets the launcher animate
     the tap into the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/quick_log_widget_background"
  android:contentDescription="@string/quick_log_label"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="16dp">

  <ImageView
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:importantForAccessibility="no"
    android:src="@drawable/quick_log_mark"
    android:tint="@color/quick_log_accent" />

  <TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:importantForAccessibility="no"
    android:maxLines="1"
    android:text="@string/quick_log_label"
    android:textColor="@color/quick_log_text"
    android:textSize="16sp" />
</LinearLayout>
