# Copy to .env — Bun loads it automatically. Never commit .env.

PORT=3000

# Where the data lives: accounts.sqlite (users and their tokens) and
# users/<id>.sqlite — each user's sync log, replica and classifier runs.
DATA_DIR=./data

# Who may create an account from the login page.
#   first  — anyone, until the first user exists (the default: open the app, create yours, done)
#   open   — anyone, always
#   closed — nobody; accounts come from the CLI: bun src/cli.js user add <name>
SIGNUP=first

# The shortest password accepted. 8 is right for a server on the internet; a box
# on your own LAN may want less.
MIN_PASSWORD_LENGTH=8

# Browser origins allowed to call the API, comma-separated, no wildcard. Only
# needed when the web app is on another origin (Metro in dev) — a deployed
# server serves the app itself, same-origin.
CORS_ORIGINS=http://localhost:8081

# The exported web app the server also serves (expo export). Unset = API only.
# In Docker this is set by the image, do not set it here.
# WEB_ROOT=../app/dist

# The zone you live in. "Today", and every time written into a line by the
# server (MCP, classifier), are read in it. Unset = the machine's zone, which in
# Docker is UTC.
# TZ=Europe/Berlin

# Habit classification. Leave AI_PROVIDER unset to turn it off.
# ollama | anthropic | openai — the switch is here, never in code.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# How often finished days are picked up for classification.
CLASSIFY_EVERY_MIN=10
