# Copy to .env — Bun loads it automatically. Never commit .env.

PORT=3000

# The one shared secret every device sends as `Authorization: Bearer …`.
DOTBOOK_TOKEN=change-me

# One SQLite file: relay messages + a replica of the client schema.
DB_PATH=./data/dotbook.sqlite

# Browser origins allowed to call the API (the web app). Comma-separated, no wildcard.
CORS_ORIGINS=http://localhost:8081

# One person, one group. Every device must send this groupId.
GROUP_ID=default

# Habit classification. Leave AI_PROVIDER unset to turn it off.
# ollama | anthropic | openai — the switch is here, never in code.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# How often finished days are picked up for classification.
CLASSIFY_EVERY_MIN=10
